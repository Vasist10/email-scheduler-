# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example committed so others know what vars are needed

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
Backend/dist/

# ── TypeScript cache ──────────────────────────────────────────────────────────
*.tsbuildinfo

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────────────────────────────
# Keep Dockerfiles and docker-compose committed
# Ignore any local override files
docker-compose.override.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Prisma ───────────────────────────────────────────────────────────────────
# Keep schema and migrations committed
# Ignore generated engine binaries (regenerated via prisma generate)
Backend/node_modules/.prisma/
