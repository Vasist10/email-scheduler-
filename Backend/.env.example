# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables
#
# Copy this file to .env and fill in real values before running the app.
#
# Local dev (npm run dev):   use "localhost" for all service hostnames
# Docker Compose:            use the service name (postgres / redis / elasticsearch)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler
# Docker Compose (replace localhost → postgres):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/email_scheduler

# Postgres container settings (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=email_scheduler

# ── Redis ────────────────────────────────────────────────────────────────────
# Local dev:
REDIS_HOST=localhost
REDIS_PORT=6379
# Docker Compose overrides these automatically to: redis / 6379

# ── Elasticsearch ────────────────────────────────────────────────────────────
# Local dev:
ELASTICSEARCH_URL=http://localhost:9200
# Docker Compose overrides this automatically to: http://elasticsearch:9200

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── JWT ──────────────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_change_this

# ── Frontend origin (CORS + OAuth redirect) ──────────────────────────────────
# Local dev:  http://localhost:5173
# Docker:     http://localhost  (nginx on port 80)
FRONTEND_URL=http://localhost:5173

# ── Ethereal SMTP ────────────────────────────────────────────────────────────
# Create a free test account at https://ethereal.email
ETHEREAL_USER=your_ethereal_username
ETHEREAL_PASS=your_ethereal_password

# ── Rate limiting & worker tuning ────────────────────────────────────────────
MAX_EMAILS_PER_HOUR=20
MIN_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5
# Total attempts BullMQ makes before a job is dead-lettered
WORKER_MAX_ATTEMPTS=3
# Exponential backoff base (ms): retry 1 = 5s, retry 2 = 10s, retry 3 = 20s
WORKER_BACKOFF_MS=5000

# ── Bull-board admin dashboard ───────────────────────────────────────────────
# Accessible at http://localhost:4000/admin/queues
# Change these before any non-local deployment.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# ── Slack OAuth ──────────────────────────────────────────────────────────────
# Create an app at https://api.slack.com/apps
# Required scopes:  chat:write  im:write  users:read
# Redirect URI to add in Slack app settings:
#   http://localhost:4000/auth/slack/callback
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback

# ── Docker Compose port overrides (optional) ─────────────────────────────────
# Uncomment to expose services on non-default host ports.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# ES_PORT=9200
# BACKEND_PORT=4000
# FRONTEND_PORT=80
# VITE_API_BASE_URL=http://localhost:4000
